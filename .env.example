# --- Telegram ---
BOT_TOKEN=123456:AA...              # @BotFather
OWNER_CHAT_ID=                      # куда падают алерты о поломке синхронизации

# --- Шифрование токенов доступа (пароли не хранятся) ---
# python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
CREDENTIALS_KEY=

# --- База ---
# В docker compose DATABASE_URL собирается сам из POSTGRES_*; задавать его нужно
# только при запуске без compose (локально подойдёт SQLite).
POSTGRES_PASSWORD=                  # openssl rand -hex 24
# DATABASE_URL=sqlite+aiosqlite:///./local.db

# --- Публичный адрес сервера подписки ---
# DOMAIN — для сертификата Let's Encrypt (Caddy). Без своего домена подойдёт
# sslip.io: IP машины через дефисы, например 51-250-1-2.sslip.io
DOMAIN=
PUBLIC_BASE_URL=https://schedule.example.ru

# --- Источник ---
RANEPA_BASE_URL=https://my.ranepa.ru
SYNC_HOUR_MSK=3
SYNC_CONCURRENCY=4
